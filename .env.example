# =============================================================================
# Aegis — environment template
# Copy to .env and fill secrets. NEVER commit .env.
# =============================================================================

# --- Application ---
AEGIS_ENV=local                       # local | dev | staging | prod
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=json                 # json | console

# --- API ---
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password_change_me
POSTGRES_DB=aegis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password_change_me@postgres:5432/aegis
# Sync URL used by Alembic
AEGIS_DATABASE_URL_SYNC=postgresql+psycopg://aegis:aegis_dev_password_change_me@postgres:5432/aegis

# --- Redis (cache + Celery broker/backend) ---
AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_CELERY_BROKER_URL=redis://redis:6379/1
AEGIS_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Identity / Auth ---
AEGIS_IDENTITY_PROVIDER=local_jwt     # local_jwt | okta
AEGIS_JWT_SECRET=replace-me-with-32-byte-random-string
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_ACCESS_TTL_SECONDS=3600
AEGIS_JWT_REFRESH_TTL_SECONDS=2592000

# Okta (unused in Phase 0; adapter is stubbed)
AEGIS_OKTA_DOMAIN=
AEGIS_OKTA_CLIENT_ID=
AEGIS_OKTA_CLIENT_SECRET=

# --- AI providers (Sprint 1+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AEGIS_DEFAULT_AI_PROVIDER=anthropic

# --- Ingestion secrets ---
# Per-source HMAC secret. The webhook sender signs with this; we verify.
# Move to DB/Vault in Phase 3.
AEGIS_INGEST_SECRET_DEFENDER=dev-defender-secret-change-me
AEGIS_INGEST_REPLAY_WINDOW_SECONDS=300

# --- Correlation ---
# Sliding-window for clustering alerts into an existing incident by
# correlation_key. New alerts within this window land on an open incident.
AEGIS_INCIDENT_CORRELATION_WINDOW_SECONDS=1800

# --- Policy ---
# Emergency lockdown: force always-escalate. Use only if a bad policy ships.
AEGIS_POLICY_ENGINE_FORCE_STUB=false

# --- Approval ---
AEGIS_APPROVAL_DEFAULT_TTL_SECONDS=3600
AEGIS_APPROVAL_REQUIRED_ROLE=operator

# --- Slack (Sprint 2 — dry-run unless slack_enabled=true) ---
AEGIS_SLACK_ENABLED=false
AEGIS_SLACK_WEBHOOK_URL=
AEGIS_SLACK_SIGNING_SECRET=
AEGIS_SLACK_APPROVAL_CHANNEL=#aegis-approvals

# --- Microsoft Graph (Sprint 2 execution connector — dry-run unless live=true) ---
AEGIS_MS_GRAPH_LIVE=false
AEGIS_MS_GRAPH_TENANT_ID=
AEGIS_MS_GRAPH_CLIENT_ID=
AEGIS_MS_GRAPH_CLIENT_SECRET=

# --- Audit log immutability (Sprint 2) ---
# If set, audit-log INSERTs use this connection. The role behind this DSN
# should have ONLY INSERT on audit_logs (no UPDATE/DELETE). Migration
# 0002_audit_writer_role creates `aegis_audit_writer` with that grant.
AEGIS_AUDIT_WRITER_DATABASE_URL=

# --- Audit export signing (Sprint 4) ---
# PEM-encoded Ed25519 private key used to sign /api/v1/audit/export
# receipts. Generate with `python -c "from app.core.audit.export_signer
# import generate_keypair_pem; p, _ = generate_keypair_pem(); print(p)"`.
# In production this MUST be set, and the matching public key MUST be
# distributed to verifiers (compliance officers / external auditors).
# When unset locally, export callers can pass ?require_signature=false
# to receive an unsigned receipt with "signature": null.
AEGIS_AUDIT_EXPORT_SIGNING_KEY=
# Stable identifier so a verifier can pin the right public key after
# rotation. Suggested format: "aegis-audit-vYYYY-MM" or a UUID.
AEGIS_AUDIT_EXPORT_SIGNING_KEY_ID=dev-unsigned

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
