# =============================================================================
# Aegis — environment template
# Copy to .env and fill secrets. NEVER commit .env.
# =============================================================================

# --- Application ---
AEGIS_ENV=local                       # local | dev | staging | prod
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=json                 # json | console

# --- API ---
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password_change_me
POSTGRES_DB=aegis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password_change_me@postgres:5432/aegis
# Sync URL used by Alembic
AEGIS_DATABASE_URL_SYNC=postgresql+psycopg://aegis:aegis_dev_password_change_me@postgres:5432/aegis

# --- Redis (cache + Celery broker/backend) ---
AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_CELERY_BROKER_URL=redis://redis:6379/1
AEGIS_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Identity / Auth ---
AEGIS_IDENTITY_PROVIDER=local_jwt     # local_jwt | okta
AEGIS_JWT_SECRET=replace-me-with-32-byte-random-string
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_ACCESS_TTL_SECONDS=3600
AEGIS_JWT_REFRESH_TTL_SECONDS=2592000

# Okta (unused in Phase 0; adapter is stubbed)
AEGIS_OKTA_DOMAIN=
AEGIS_OKTA_CLIENT_ID=
AEGIS_OKTA_CLIENT_SECRET=

# --- AI providers (Sprint 1+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AEGIS_DEFAULT_AI_PROVIDER=anthropic

# --- Ingestion secrets ---
# Per-source HMAC secret. The webhook sender signs with this; we verify.
# Move to DB/Vault in Phase 3.
AEGIS_INGEST_SECRET_DEFENDER=dev-defender-secret-change-me
AEGIS_INGEST_REPLAY_WINDOW_SECONDS=300

# --- Correlation ---
# Sliding-window for clustering alerts into an existing incident by
# correlation_key. New alerts within this window land on an open incident.
AEGIS_INCIDENT_CORRELATION_WINDOW_SECONDS=1800

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
